import streamlit as st
from ultralytics import YOLO
import cv2
import tempfile
from PIL import Image
import numpy as np

st.set_page_config(page_title="ASELSAN Gözetleme AI", layout="wide")
st.title("ASELSAN Gözetleme Yapay Zeka")
st.write("YOLOv8 ile Gerçek Zamanlı Nesne Tespiti")

@st.cache_resource
def load_model():
    model = YOLO('yolov8n.pt')
    return model

model = load_model()

secenek = st.radio("Kaynak Seç:", ["Webcam", "Video Yükle"])

if secenek == "Webcam":
    run = st.button('Webcamı Başlat')
    FRAME_WINDOW = st.image([])
    if run:
        cap = cv2.VideoCapture(0)
        while run:
            ret, frame = cap.read()
            if not ret:
                break
            results = model(frame)
            res_plotted = results[0].plot()
            FRAME_WINDOW.image(res_plotted, channels="BGR")
        cap.release()

elif secenek == "Video Yükle":
    video_file = st.file_uploader("Video yükle", type=['mp4', 'mov', 'avi'])
    if video_file is not None:
        tfile = tempfile.NamedTemporaryFile(delete=False)
        tfile.write(video_file.read())
        cap = cv2.VideoCapture(tfile.name)
        FRAME_WINDOW = st.image([])
        while cap.isOpened():
            ret, frame = cap.read()
            if not ret:
                break
            results = model(frame)
            res_plotted = results[0].plot()
            FRAME_WINDOW.image(res_plotted, channels="BGR")
        cap.release()
